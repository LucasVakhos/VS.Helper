<?xml version="1.0" encoding="utf-8"?>
<VSHelperZip>
  <Root>.</Root>
  <OutputDir>_zip</OutputDir>
  <ArchiveName>$(SolutionName)_$(Date)_$(Time).zip</ArchiveName>
  <StartProject>VS.Helper.csproj</StartProject>
  <IncludeProjectClosure>true</IncludeProjectClosure>
  <IncludeSolutionFiles>true</IncludeSolutionFiles>
  <IncludeManifest>true</IncludeManifest>
  <Include>
    <File>VS.Helper.slnx</File>
    <File>VS.Helper.Zip.xml</File>
    <File>README.md</File>
    <File>LICENSE.txt</File>
    <File>Directory.Build.*</File>
    <File>Directory.Packages.props</File>
    <File>NuGet.config</File>
  </Include>
  <Exclude>
    <Pattern>bin/**</Pattern>
    <Pattern>**/bin/**</Pattern>
    <Pattern>obj/**</Pattern>
    <Pattern>**/obj/**</Pattern>
    <Pattern>.vs/**</Pattern>
    <Pattern>**/.vs/**</Pattern>
    <Pattern>.git/**</Pattern>
    <Pattern>**/.git/**</Pattern>
    <Pattern>packages/**</Pattern>
    <Pattern>**/packages/**</Pattern>
    <Pattern>VSIX/**</Pattern>
    <Pattern>**/VSIX/**</Pattern>
    <Pattern>_zip/**</Pattern>
    <Pattern>**/_zip/**</Pattern>
    <Pattern>*.zip</Pattern>
    <Pattern>*.vsix</Pattern>
    <Pattern>*.pdb</Pattern>
    <Pattern>*.user</Pattern>
    <Pattern>*.suo</Pattern>
    <Pattern>*.log</Pattern>
  </Exclude>
</VSHelperZip>
