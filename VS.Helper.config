<?xml version="1.0" encoding="utf-8"?>
<VSHelperZip>
  <Root>.</Root>
  <OutputDir>_zip</OutputDir>
  <ArchiveName>{Solution.Name}.zip</ArchiveName>
  <StartProject>VS.Helper.csproj</StartProject>
  <IncludeProjectClosure>true</IncludeProjectClosure>
  <IncludeSolutionFiles>true</IncludeSolutionFiles>
  <IncludeManifest>true</IncludeManifest>
  <Include>
    <File>AI</File>
    <File>Commands</File>
    <File>Core</File>
    <File>Helpers</File>
    <File>Properties</File>
    <File>Resources</File>
    <File>ToolWindow</File>
    <File>VsRoot</File>
    <File>.gitattributes</File>
    <File>.gitignore</File>
    <File>ABOUT.md</File>
    <File>ARCHITECTURE.md</File>
    <File>CHECKPOINT.json</File>
    <File>CTO.md</File>
    <File>extension.vsixmanifest</File>
    <File>GlobalUsings.cs</File>
    <File>LICENSE.txt</File>
    <File>PackageGuids.cs</File>
    <File>PackageIds.cs</File>
    <File>README.md</File>
    <File>SELF_REWRITE.md</File>
    <File>source.extension.cs</File>
    <File>source.extension.vsixmanifest</File>
    <File>VS.Helper.config</File>
    <File>VS.Helper.csproj</File>
    <File>VS.Helper.slnx</File>
    <File>VSCommandTable.cs</File>
    <File>VSCommandTable.vsct</File>
    <File>VSExtensionPackage.cs</File>
    <File>VSHelperPackage.cs</File>
  </Include>
  <Exclude>
    <Pattern>bin/**</Pattern>
    <Pattern>**/bin/**</Pattern>
    <Pattern>obj/**</Pattern>
    <Pattern>**/obj/**</Pattern>
    <Pattern>.vs/**</Pattern>
    <Pattern>**/.vs/**</Pattern>
    <Pattern>.git/**</Pattern>
    <Pattern>**/.git/**</Pattern>
    <Pattern>.idea/**</Pattern>
    <Pattern>**/.idea/**</Pattern>
    <Pattern>.vscode/**</Pattern>
    <Pattern>**/.vscode/**</Pattern>
    <Pattern>packages/**</Pattern>
    <Pattern>**/packages/**</Pattern>
    <Pattern>TestResults/**</Pattern>
    <Pattern>**/TestResults/**</Pattern>
    <Pattern>_zip/**</Pattern>
    <Pattern>**/_zip/**</Pattern>
    <Pattern>VSIX/**</Pattern>
    <Pattern>**/VSIX/**</Pattern>
    <Pattern>*.user</Pattern>
    <Pattern>*.suo</Pattern>
    <Pattern>*.cache</Pattern>
    <Pattern>*.log</Pattern>
    <Pattern>*.zip</Pattern>
    <Pattern>*.nupkg</Pattern>
    <Pattern>*.vsix</Pattern>
    <Pattern>*.pdb</Pattern>
    <Pattern>VS.Helper.Zip.xml</Pattern>
    <Pattern>**/*.bak</Pattern>
    <Pattern>**/*.tmp</Pattern>
  </Exclude>
</VSHelperZip>