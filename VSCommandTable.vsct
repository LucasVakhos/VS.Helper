	<Commands package="guidVSHelperPackage">
		<Groups>
			<Group guid="guidVSHelperPackageCmdSet" id="VSHelperGroup" priority="0x0600">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_EDIT" />
			</Group>
		</Groups>

		<Buttons>
			<Button guid="guidVSHelperPackageCmdSet" id="AppCleanerToolsCommand" priority="0x0500" type="Button">
				<Parent guid="guidVSHelperPackageCmdSet" id="VSHelperGroup" />
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>VS.Helper: AppCleaner Tools</ButtonText>
				</Strings>
			</Button>
			<Button guid="guidVSHelperPackageCmdSet" id="CreateCommentCommand" priority="0x0100" type="Button">
				<Parent guid="guidVSHelperPackageCmdSet" id="VSHelperGroup" />
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>VS.Helper: Create Comment</ButtonText>
