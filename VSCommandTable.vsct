			<Button guid="guidVSHelperPackageCmdSet" id="BuildZipCommand" priority="0x0200" type="Button">
				<Parent guid="guidVSHelperPackageCmdSet" id="VSHelperGroup" />
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>VS.Helper: Build ZIP</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidVSHelperPackageCmdSet" id="CreateZipConfigCommand" priority="0x0300" type="Button">
