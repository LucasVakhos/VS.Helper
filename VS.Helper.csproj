<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssetTargetFallback>$(AssetTargetFallback);net48;net472;net461</AssetTargetFallback>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <UseCodebase>true</UseCodebase>
    <VsixIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\</VsixIntermediateOutputPath>
    <TemplateOutputDirectory>$(VsixIntermediateOutputPath)</TemplateOutputDirectory>
    <CreateTemplateManifestsCacheFile>$(VsixIntermediateOutputPath)createTemplateManifests.cache</CreateTemplateManifestsCacheFile>
    <TargetName>VS.Helper</TargetName>
    <TargetVsixContainerName>VS.Helper.vsix</TargetVsixContainerName>
    <TargetVsixContainer>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(TargetVsixContainerName)</TargetVsixContainer>
    <CreatePkgDefAssemblyToProcess>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\VS.Helper.dll</CreatePkgDefAssemblyToProcess>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Helpers\**\*.cs" />
    <Compile Remove="VsRoot\**\*.cs" />
    <Page Remove="Helpers\**\*.xaml" />
    <EmbeddedResource Remove="Helpers\**" />
    <None Remove="Helpers\**" />
    <Content Remove="Helpers\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Helpers\VSHelperEngine.cs" />
    <Compile Include="Helpers\VSHelperLogDialog.cs" />
    <Compile Include="Helpers\VSHelperToolsDialog.cs" />
    <Compile Include="Helpers\VSHelperToolsHelper.cs" />
    <Compile Include="Helpers\Classes\VSHelperComboTodoAttribute.cs" />
    <Compile Include="Helpers\Classes\VSHelperComboTodoItems.cs" />
    <Compile Include="Helpers\Classes\VSHelperEnumExtensions.cs" />
    <Compile Include="Helpers\Classes\VSHelperOperationTypes.cs" />
    <Compile Include="Helpers\Classes\VSHelperOptions.cs" />
    <Compile Include="Helpers\Classes\VSHelperPatternType.cs" />
    <Compile Include="Helpers\Classes\VSHelperSolutionInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.551" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.4" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Community.VisualStudio.Toolkit">
      <HintPath>$(NuGetPackageRoot)community.visualstudio.toolkit.17\17.0.551\lib\net48\Community.VisualStudio.Toolkit.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Resources\**\*.cs" />
    <None Remove="Resources\source.extension.vsixmanifest" />
    <None Remove="Resources\source.extension.cs" />
    <Compile Remove="**\VSExtensionPackage.cs" />
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <None Update="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </None>
    <Content Include="Resources\Icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <None Include="VsRoot\source.extension.cs">
      <DependentUpon>source.extension.vsixmanifest</DependentUpon>
    </None>
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <Content Include="Resources\CommandIcons16.png" />
    <Content Include="Resources\Icon32.png" />
  </ItemGroup>

  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />

  <Target Name="EnsureVsixInBin" AfterTargets="CreateVsixContainer">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\$(TargetVsixContainerName)"
      DestinationFolder="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)"
      Condition="Exists('$(MSBuildProjectDirectory)\$(TargetVsixContainerName)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>